{
	"name": "@ics-ai/copilot-api-sdk",
	"version": "1.0.0",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.8.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.8.1",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@biomejs/biome": "^2.5.15",
		"publint": "^0.3.25",
		"tsdown": "^0.23.0",
		"typescript": "7.0.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"axios": "^1.20.0",
		"zod": "^4.6.5"
	}
}
